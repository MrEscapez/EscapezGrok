# Copy to deployment/staff-panel/.env — never commit real secrets.
# Kopieer en vervang CHANGE_ME voor productie.

STAFF_HTTP_PORT=8080
STAFF_CORS_ORIGIN=http://localhost:8080

STAFF_POSTGRES_DB=escapezcraft_staff
STAFF_POSTGRES_USER=escapez_staff
STAFF_POSTGRES_PASSWORD=CHANGE_ME
STAFF_POSTGRES_PORT=5433

SESSION_SECRET=CHANGE_ME
SESSION_COOKIE_SECURE=false

STAFF_BOOTSTRAP_USERNAME=admin
STAFF_BOOTSTRAP_PASSWORD=CHANGE_ME
STAFF_SEED_HELPER=true
STAFF_HELPER_USERNAME=helper
STAFF_HELPER_PASSWORD=CHANGE_ME

BRIDGE_API_KEY=CHANGE_ME_BRIDGE_KEY
