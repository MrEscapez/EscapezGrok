# EscapezCraft deployment example — DO NOT use real secrets in git
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=escapezcraft
POSTGRES_USER=escapez
POSTGRES_PASSWORD=CHANGE_ME

# EscapezCore runtime (preferred over config.yml password)
ESCAPEZ_DB_URL=jdbc:postgresql://127.0.0.1:5432/escapezcraft
ESCAPEZ_DB_USER=escapez
ESCAPEZ_DB_PASSWORD=CHANGE_ME

# EscapezCore ↔ Staff Panel bridge (same value family as BRIDGE_API_KEY)
ESCAPEZ_API_KEY=CHANGE_ME
ESCAPEZ_HMAC_SECRET=CHANGE_ME

# Minecraft / panel (placeholders)
MINECRAFT_HOST=127.0.0.1
STAFF_PANEL_URL=https://example.com/staff-panel
DISCORD_INVITE=https://example.com/discord

# --- Staff Panel (FASE 11–12) — placeholders only ---
STAFF_POSTGRES_DB=escapezcraft_staff
STAFF_POSTGRES_USER=escapez_staff
STAFF_POSTGRES_PASSWORD=CHANGE_ME
STAFF_POSTGRES_PORT=5433
STAFF_BACKEND_PORT=3000
STAFF_FRONTEND_PORT=8080
STAFF_CORS_ORIGIN=http://localhost:5173
STAFF_SESSION_SECRET=CHANGE_ME
STAFF_PUBLIC_API_URL=http://localhost:3000
BRIDGE_API_KEY=CHANGE_ME
