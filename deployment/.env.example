# EscapezCraft deployment example — DO NOT use real secrets in git
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=escapezcraft
POSTGRES_USER=escapez
POSTGRES_PASSWORD=CHANGE_ME

# EscapezCore runtime (preferred over config.yml password)
ESCAPEZ_DB_URL=jdbc:postgresql://127.0.0.1:5432/escapezcraft
ESCAPEZ_DB_USER=escapez
ESCAPEZ_DB_PASSWORD=CHANGE_ME

# Minecraft / panel (placeholders)
MINECRAFT_HOST=127.0.0.1
STAFF_PANEL_URL=https://example.com/staff-panel
DISCORD_INVITE=https://example.com/discord
