# EscapezCraft Staff Panel — backend env example
# Copy to .env and replace CHANGE_ME values. Never commit real secrets.
# Kopieer naar .env en vervang CHANGE_ME. Commit nooit echte secrets.

PORT=3000
NODE_ENV=development

# CORS — frontend origin(s), comma-separated / komma-gescheiden
CORS_ORIGIN=http://localhost:5173

# Session (HttpOnly cookie) — CHANGE_ME in any real environment
SESSION_SECRET=CHANGE_ME
SESSION_COOKIE_NAME=escapez_staff_session
SESSION_MAX_AGE_MS=86400000

# Bootstrap stub user for local demo (plaintext only here; hashed with bcrypt at boot into memory)
# Lokale demo-gebruiker: plaintext alleen in .env; bij start gehashed met bcrypt in geheugen
STAFF_BOOTSTRAP_USERNAME=admin
STAFF_BOOTSTRAP_PASSWORD=CHANGE_ME


# EscapezCore -> Staff Panel bridge (server-to-server). NEVER expose to frontend.
# Header: X-Escapez-Api-Key. HMAC-ready headers reserved (see README).
BRIDGE_API_KEY=CHANGE_ME_BRIDGE_KEY

# Optional EscapezCore base URL for Panel → Core module push (FASE 10 stub).
# When empty: toggles persist locally with syncStatus=pending.
# Example: http://127.0.0.1:8080
CORE_API_BASE=
CORE_API_TIMEOUT_MS=3000

# Optional path for modules.json persistence (default: ./data/modules.json)
# MODULES_DATA_PATH=

# PostgreSQL (placeholders only)
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=escapezcraft_staff
POSTGRES_USER=escapez_staff
POSTGRES_PASSWORD=CHANGE_ME

# Password hashing
PASSWORD_HASH_ALGO=bcrypt

# Discord / site URLs — placeholders only (no tokens)
DISCORD_INVITE_URL=https://example.com/discord
SITE_URL=https://example.com
STAFF_PANEL_PUBLIC_URL=https://example.com/staff-panel
