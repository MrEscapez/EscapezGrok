# EscapezCraft Staff Panel — backend env example
# Copy to .env and replace CHANGE_ME values. Never commit real secrets.
# Kopieer naar .env en vervang CHANGE_ME. Commit nooit echte secrets.

PORT=3000
NODE_ENV=development

# CORS — frontend origin(s), comma-separated / komma-gescheiden
CORS_ORIGIN=http://localhost:5173

# Session (HttpOnly cookie) — CHANGE_ME in any real environment
SESSION_SECRET=CHANGE_ME
SESSION_COOKIE_NAME=escapez_staff_session
SESSION_MAX_AGE_MS=86400000

# Bootstrap stub user for local demo (plaintext only here; hashed with bcrypt at boot into memory)
# Lokale demo-gebruiker: plaintext alleen in .env; bij start gehashed met bcrypt in geheugen
STAFF_BOOTSTRAP_USERNAME=admin
STAFF_BOOTSTRAP_PASSWORD=CHANGE_ME


# EscapezCore <-> Staff Panel bridge (server-to-server). NEVER expose to frontend.
# Header: X-Escapez-Api-Key only (never Bearer). HMAC-ready headers reserved (see README).
# Same shared secret as EscapezCore ESCAPEZ_API_KEY (key alignment).
BRIDGE_API_KEY=CHANGE_ME_BRIDGE_KEY

# EscapezCore inbound API base for Panel → Core module GET/PATCH (default below).
# Unset in process env → code default http://127.0.0.1:8765 (Core listen port).
# Set CORE_API_BASE=off (or disabled|false|none|empty) to disable the proxy;
# toggles then persist locally with syncStatus=pending.
CORE_API_BASE=http://127.0.0.1:8765
CORE_API_TIMEOUT_MS=3000

# Optional path for modules.json persistence (default: ./data/modules.json)
# MODULES_DATA_PATH=

# PostgreSQL (placeholders only)
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=escapezcraft_staff
POSTGRES_USER=escapez_staff
POSTGRES_PASSWORD=CHANGE_ME

# Password hashing
PASSWORD_HASH_ALGO=bcrypt

# Discord / site URLs — placeholders only (no tokens)
DISCORD_INVITE_URL=https://example.com/discord
SITE_URL=https://example.com
STAFF_PANEL_PUBLIC_URL=https://example.com/staff-panel

# ─── FASE 15: Minecraft RCON (backend ONLY — never expose to frontend) ───
# Optional. If missing/CHANGE_ME → stub mode (503 on send, status source=stub).
# NL: Alleen in backend .env; frontend mag deze waarden nooit zien of loggen.
RCON_HOST=
RCON_PORT=25575
RCON_PASSWORD=CHANGE_ME

# ─── FASE 15: Pterodactyl Client API (backend ONLY) ───
# Optional. If incomplete → stub power/status. Never put API key in Vite/frontend.
# PTERO_BASE_URL example: https://panel.example.com
PTERO_BASE_URL=
PTERO_API_KEY=CHANGE_ME
PTERO_SERVER_ID=
# Optional Client API key (power/resources). Application key is primary for listing.
PTERO_CLIENT_API_KEY=
# Runtime overlay file (gitignored). Prefer Settings UI; env is bootstrap fallback.
# PTERO_DATA_PATH=./data/ptero.json

# ─── RBAC seed users (in-memory + data/rbac.json, gitignored) ───
# Admin always seeded with role `admin` (all permissions). Demo: admin / CHANGE_ME
# Optional helper (role `helper`): document only — enable/disable via STAFF_SEED_HELPER
STAFF_SEED_HELPER=true
STAFF_HELPER_USERNAME=helper
STAFF_HELPER_PASSWORD=CHANGE_ME
# Optional path for rbac.json (default: ./data/rbac.json)
# RBAC_DATA_PATH=
